# Go 运行环境变量模板（复制为 .env 使用：cp .env.example .env）

# MySQL 连接（依赖可由 docker compose 起，见 docker-compose.yml / plans/PLAN-docker.md）
# 本机已有 MySQL/Redis 时容器映射 3307/6380 避让：.env 改填容器端口 DB_PORT=3307、REDIS_ADDR=127.0.0.1:6380
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 本机直连填本机凭证；容器场景对齐 compose 的 MYSQL_USER/MYSQL_PASSWORD（app_user）
DB_PASSWORD=
DB_NAME=gyz_db

# HTTP 服务端口
SERVER_PORT=8080

# 日志级别：debug/info/warn/error（debug 会输出全部 SQL 执行日志，排查问题时临时打开）
LOG_LEVEL=info

# Redis 连接（鉴权白名单存储；容器映射 6380 避让本机 6379）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 签发密钥（必填：空值启动直接退出；建议 32+ 位随机串，如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-32-bytes-or-longer-secret
# JWT 有效期（小时），同时是 Redis 白名单 TTL
JWT_TTL_HOURS=24

# 小鹅通开放平台 API 域名（直播登录链接透传 xe.login.url 的上游 base，一般无需修改）
XIAOE_API_BASE=https://api.xiaoe-tech.com
# RabbitMQ 连接（订单事件 order.created 发布/消费，见 plans/PLAN-order.md；docker compose 起 rabbitmq 后默认 guest/guest，管理台 :15672）
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ==================== 容器构建可选变量（仅 docker compose build/up 插值用）====================
# 弱网拉不动 docker.io 时取消注释换 daocloud 源（弱网先例见 plans/PLAN-docker.md 实测记录）
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.24-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.21
# GOPROXY=https://goproxy.cn,direct
# APP_TAG 勿在此设置：它是 ./deploy.sh 发版时内部注入的镜像 tag 变量，手动 compose 命令带它
# 会打出该版本 tag 却走无 GIT_REV 的构建路径，污染版本历史（见 plans/PLAN-docker.md 决策 12）

# ==================== 前端监控（mon_event/mon_alert，见 PLAN-frontend-monitor.md）====================
# 告警扫描任务开关（false 时 server 不起告警 goroutine）
MON_ALERT_ENABLED=true
# 扫描间隔（分钟）与统计滚动窗口（分钟）
MON_ALERT_INTERVAL_MIN=5
MON_ALERT_WINDOW_MIN=10
# 参与告警的环境（逗号分隔；默认仅 production——test 刷数据不应告警）
MON_ALERT_ENVS=production
# 三规则阈值（窗口内事件数 > 阈值触发）：能力探测失败 / chunk 加载失败激增(P0) / JS 错误激增(P1)
MON_ALERT_PROBE_FAIL_THRESHOLD=0
MON_ALERT_CHUNK_THRESHOLD=10
MON_ALERT_ERROR_THRESHOLD=50
# 事件保留天数（每日分批清理）
MON_RETENTION_DAYS=90
# 告警 webhook（钉钉/企微自定义机器人；留空=仅落表+看板展示，不推送）
MON_ALERT_WEBHOOK_URL=

# 事件落库开关（默认 true：上报入库；false：不上报入库，chunk_load_error 即时推企微，其余事件静默丢弃）
MON_EVENT_PERSIST_ENABLED=true
