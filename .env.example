# Go 运行环境变量模板（复制为 .env 使用：cp .env.example .env）

# MySQL 连接（依赖可由 docker compose 起，见 docker-compose.yml / PLAN-docker.md）
# 本机已有 MySQL/Redis 时容器映射 3307/6380 避让：.env 改填容器端口 DB_PORT=3307、REDIS_ADDR=127.0.0.1:6380
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 本机直连填本机凭证；容器场景对齐 compose 的 MYSQL_USER/MYSQL_PASSWORD（app_user）
DB_PASSWORD=
DB_NAME=handicap_db

# HTTP 服务端口
SERVER_PORT=8080

# 日志级别：debug/info/warn/error（debug 会输出全部 SQL 执行日志，排查问题时临时打开）
LOG_LEVEL=info

# Redis 连接（鉴权白名单存储；容器映射 6380 避让本机 6379）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 签发密钥（必填：空值启动直接退出；建议 32+ 位随机串，如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-32-bytes-or-longer-secret
# JWT 有效期（小时），同时是 Redis 白名单 TTL
JWT_TTL_HOURS=24

# 小鹅通开放平台 API 域名（直播登录链接透传 xe.login.url 的上游 base，一般无需修改）
XIAOE_API_BASE=https://api.xiaoe-tech.com
# RabbitMQ 连接（订单事件 order.created 发布/消费，见 PLAN-order.md；docker compose 起 rabbitmq 后默认 guest/guest，管理台 :15672）
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
