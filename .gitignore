# 环境变量（含本地密码，不入库）
.env
# 测试服务器部署配置（同上含密码，仅本地留档，scp 时改名 .env）
deploy/.env.server

# 二进制与构建产物
/bin/
*.exe
*.test

# IDE
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# 日志
*.log

# 本地调试产物与工具配置
.playwright-mcp/
.claude/
# Redis 本地调试产物（redis-cli shutdown 默认 dump）
dump.rdb
# 数据库备份（含密码哈希与业务数据，不入库；导出方式见 mysqldump 命令）
backups/
